# ---- Honeypot Atlas API (application tier) ----
# Load with:  node --env-file=.env src/index.js      (or systemd EnvironmentFile=)

# Where the API listens. Keep it on loopback when Nginx runs on the same host;
# use 0.0.0.0 only when the reverse proxy is on another host/container.
HOST=0.0.0.0
PORT=3000

# Data tier (PostgreSQL). URL-encode special characters in the password.
DATABASE_URL=postgres://atlas:YOUR_DATABASE_PASSWORD@atlas-postgres:5432/atlas
DB_POOL_MAX=10
# true = run ../database/schema.sql at startup (convenient for dev). Default false: apply it yourself with psql.
AUTO_MIGRATE=false

# Reverse proxy awareness. "loopback" trusts Nginx on the same host so the real client IP is used in the
# audit log and login throttling. Use "true" for any proxy in front, or a CIDR list e.g. "172.18.0.0/16".
TRUST_PROXY=loopback

SESSION_TTL_HOURS=12
# true when users reach the site over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false

# ---- Safety: everything is SIMULATED by default ----
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=4000
# Accept events from real sensors on POST /api/ingest (needs the API key). Leave false unless you have
# explicit authorization and an isolated network segment for the sensors.
INGEST_ENABLED=false
DEMO_MODE=true

# ---- First run seeding ----
SEED_ON_EMPTY=true
SEED_DAYS=30
# Initial password of the three seeded accounts (a.rivera admin, s.kapoor analyst, m.chen viewer)
SEED_PASSWORD=change-me-before-first-start

# ---- Optional ----
# Serve the static frontend from the API process (dev/testing only; in the 3-tier setup Nginx does this)
FRONTEND_DIR=
# e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=atlas@localhost
